# SHU-29 "Continue with Universe" (Authentik OIDC authorization-code flow).
# Client id and redirect URI are registered in Authentik (auth.bawes.net) by ops.
# The redirect URI must point at the SPA's /auth/callback route (e.g. https://<app-origin>/auth/callback).
# Leaving VITE_AUTHENTIK_CLIENT_ID/VITE_AUTHENTIK_REDIRECT_URI empty disables the button (safe no-op with console error).
VITE_AUTHENTIK_ISSUER_URL=https://auth.bawes.net
VITE_AUTHENTIK_CLIENT_ID=
VITE_AUTHENTIK_REDIRECT_URI=
